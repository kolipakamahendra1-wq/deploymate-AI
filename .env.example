# Variable names only. Copy to .env and fill in locally; never commit .env.

# Free hosted model via any OpenAI-compatible endpoint (default: OpenRouter).
# Leave LLM_API_KEY empty to run the offline rule-based agents.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Database. Defaults to SQLite (sqlite:///deploymate.db); docker compose uses Postgres + pgvector.
DATABASE_URL=
POSTGRES_PASSWORD=

# Comma-separated origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:5173

# 21st.dev component catalog (only needed when installing components).
API_KEY_21ST=
