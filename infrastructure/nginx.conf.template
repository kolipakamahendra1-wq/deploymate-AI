server {
  listen ${PORT};
  listen [::]:${PORT};
  root /usr/share/nginx/html;

  # Resolve the backend per request (not once at start-up), so nginx starts even if the
  # backend or private DNS is not ready yet. NGINX_LOCAL_RESOLVERS comes from /etc/resolv.conf.
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
  set $backend ${BACKEND_URL};

  # API calls go to the backend; buffering off so pipeline progress streams live.
  # Local models can take minutes per stage, hence the long read timeout.
  location /api/ {
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $backend;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_read_timeout 1800s;
  }

  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # Single-page app routes
  location / {
    try_files $uri /index.html;
  }
}
